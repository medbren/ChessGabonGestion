// Génère le client Prisma utilisé dans le code TypeScript.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum Platform {
  LICHESS
  CHESSCOM
  OTHER
}

enum TimeControl {
  BULLET
  BLITZ
  RAPID
  CLASSICAL
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
}

model Member {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  pseudo    String   @unique
  lichess   String?
  chesscom  String?
  createdAt DateTime @default(now())

  results   Result[]
}

model Tournament {
  id          Int         @id @default(autoincrement())
  name        String
  platform    Platform
  timeControl TimeControl
  date        DateTime
  /// Lien public Chess.com / Lichess (pour parties & partage)
  externalUrl String?

  results     Result[]
}

model Result {
  id                 Int        @id @default(autoincrement())
  memberId           Int
  tournamentId       Int
  points             Float
  championshipPoints Int        @default(0)
  rank               Int?

  member             Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tournament         Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  @@unique([memberId, tournamentId])
}
